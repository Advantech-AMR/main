# === Module Switches ===
# General Custom Package Modules
ENABLE_WEB_CONTROLLER=false
ENABLE_MAP_INTEGRATION=false
ENABLE_CUSTOM_BOUNDARY=false

# Free Mode Specific Startup Switches
# (These only take effect when APP_MODE=free)
START_BASE_CONTROL=false          # Start EKF base serial control (Physical Mode only)
START_LIDAR=false                 # Start sllidar (Physical Mode only)
START_SIMULATION=false             # Start Gazebo Simulation (Virtual Mode only)
START_SLAM_TOOLBOX=false          # Start slam_toolbox
START_NAV2=false                  # Start Nav2 localization & navigation
START_AUTO_EXPLORER=false         # Start auto_explorer node
START_ZED_CAMERA=true            # Start ZED camera wrapper (Physical Mode only)
START_ZED_VISUALIZER=false        # Start ZED object visualizer (Physical Mode only)
START_ZED_MAPPING=true           # Start ZED 3D mapping node (Physical Mode only)

# === Global Mode Settings ===
SIMULATE_MODE=false                # true for Virtual (Gazebo), false for Physical Robot
ROS_DOMAIN_ID=36
DISPLAY=:0

# === Application Mode ===
# Supported modes:
# - slam          (Pure SLAM mapping)
# - nav2          (Pure Navigation using pre-loaded map)
# - slam_nav2     (SLAM mapping + Navigation)
# - auto_explore  (Auto-exploration)
# - zed_detect    (ZED Object Detection - Physical only)
# - zed_mapping   (ZED 3D Object Mapping - Physical only)
# - free          (Free Mode: starts only modules enabled in Module Switches above)
APP_MODE=free

# === Map & World configuration ===
# Virtual World name (maps to /worlds/virtual/<WORLD_NAME>/<WORLD_NAME>.sdf)
WORLD_NAME=my-nav-map
# Path to map yaml file (used by nav2 and slam_nav2)
# Virtual: /worlds/virtual/<WORLD_NAME>/maps/slam_map.yaml
# Physical: /worlds/physical/slam_map.yaml
MAP_PATH=/worlds/virtual/my-nav-map/maps/slam_map.yaml

# === ZED & Visualization Settings ===
ZED_CAMERA_MODEL=zedx            # zed, zed2, zed2i, zedx, zedxm, etc.
ENABLE_RVIZ=true                  # true to open RViz2 / ZED Visualizer (requires X11 display)